{$DOMAIN} {
	encode zstd gzip

	request_body {
		max_size 25MB
	}

	header {
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		X-Frame-Options DENY
		-Server
	}

	# Keep the container hop on HTTP/1.1; the app's Uvicorn listener is HTTP/1 only.
	reverse_proxy app:8000 {
		transport http {
			versions 1.1
		}
	}
}
