# Tabword 使用独立 API Key；不会读取 DAYIPAPER_PAT。
TABWORD_API_KEY=
# 生产部署建议用文件挂载而不是把密钥写进环境文件。
TABWORD_API_KEY_FILE=
# 仅 origin，不含 /api。新站代码使用 api.tabword.com；格式文档示例仍为旧域名。
TABWORD_BASE_URL=https://api.tabword.com
TABWORD_FORMAT_BASE_URL=https://apihub.ycjg.top
# 当前用户要求不提交：保留 false。包括 GET 结果查询，因为查询成功可触发扣费。
TABWORD_ENABLE_CALLS=false
# 格式排版等接口文档标记开发中，官方上线后再启用。
TABWORD_ENABLE_DEVELOPMENT=false

# 支付宝当面付（网页展示二维码）。正式收款前需在支付宝开放平台开通当面付。
# 通知验签的密钥是“支付宝公钥”，不是应用公钥。
ALIPAY_ENABLED=false
ALIPAY_APP_ID=2021007108658866
ALIPAY_APP_PRIVATE_KEY_FILE=
ALIPAY_PUBLIC_KEY_FILE=
ALIPAY_NOTIFY_URL=
ALIPAY_MODE=production
ALIPAY_SELLER_ID=
# 暂按论文排版导出 ¥29.99；登录接入后再实现新用户优惠判定。
THESIS_FORMAT_PRICE_CENTS=2999

# EC2/Compose 生产部署（本地运行可留空）
DOMAIN=your-domain.example
THESIS_ENV=production
THESIS_ALLOWED_HOSTS=
# 默认公开访问；如需访问口令，填写用户名并配置密码文件。
THESIS_AUTH_USER=
THESIS_AUTH_PASS=
THESIS_AUTH_PASS_FILE=
THESIS_REQUIRE_AUTH=false
# 独立保护分销后台；设置用户名和密码文件后开放 /admin/affiliates。
AFFILIATE_ADMIN_USER=
AFFILIATE_ADMIN_PASS_FILE=
# Docker secrets 中的可选文件路径；本地默认仍兼容 .secrets/。
DAYIPAPER_PAT_FILE=
