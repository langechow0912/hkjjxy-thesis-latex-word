# 复制为 .env 后填写：cp .env.example .env
# 对外访问的域名，必须已把 A 记录解析到服务器公网 IP
DOMAIN=thesis.example.com

# ---- 云端排版通道（大易论文排版开放接口）----
# 在开放平台申请 Personal Access Token（PAT），填到这里即启用 http://你的域名/api/dayipaper 系列接口。
# 留空 = 整条云端通道关闭，本地 LaTeX 流水线不受影响。
# 注意：.env 已在 .gitignore 里，别把 PAT 提交进仓库，也别写进命令行历史。
DAYIPAPER_PAT=
# 服务地址，一般不用改
DAYIPAPER_BASE=https://transport.b1n1.dayipaper.com
# 同时进行的云端任务上限 / 轮询间隔（秒，最低 1，低于 1 秒会被对端风控拦）/ 轮询超时（秒）
THESIS_MAX_CLOUD_JOBS=3
THESIS_CLOUD_POLL=2
THESIS_CLOUD_TIMEOUT=900
