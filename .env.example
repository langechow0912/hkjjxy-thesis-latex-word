# 大以论文：所有院校（包括海口经济学院）的排版必需。
# Docker 部署请将 PAT 单独保存到 deploy/secrets/dayipaper_pat，容器从
# /run/secrets/dayipaper_pat 读取；无需把密钥写进 .env。

# Tabword 使用独立 API Key；不会读取 DAYIPAPER_PAT。
TABWORD_API_KEY=
# 生产部署建议用文件挂载而不是把密钥写进环境文件。
TABWORD_API_KEY_FILE=
# 仅 origin，不含 /api。新站代码使用 api.tabword.com；格式文档示例仍为旧域名。
TABWORD_BASE_URL=https://api.tabword.com
TABWORD_FORMAT_BASE_URL=https://apihub.ycjg.top
# 涉及计费的接口默认关闭；确认服务商账户、密钥和收费规则后再启用。
TABWORD_ENABLE_CALLS=false
# 格式排版等接口文档标记开发中，官方上线后再启用。
TABWORD_ENABLE_DEVELOPMENT=false

# 支付宝电脑网站支付（跳转支付宝收银台）。正式收款前需开通并绑定电脑网站支付。
# 通知验签的密钥是“支付宝公钥”，不是应用公钥。
ALIPAY_ENABLED=false
ALIPAY_APP_ID=2021007108658866
ALIPAY_APP_PRIVATE_KEY_FILE=
ALIPAY_PUBLIC_KEY_FILE=
ALIPAY_NOTIFY_URL=
# 电脑网站支付完成后返回的网站地址（可填首页）。
ALIPAY_RETURN_URL=https://lunwenpaiban.dpdns.org/
ALIPAY_MODE=production
ALIPAY_SELLER_ID=
# 暂按论文排版导出 ¥29.99；登录接入后再实现新用户优惠判定。
THESIS_FORMAT_PRICE_CENTS=2999

# 海口经济学院本地排版开关（用 LibreOffice 套学校封面模板）。
# true：海口经济学院走本地模板，镜像安装 LibreOffice，建议内存 ≥ 2 GB 且 THESIS_MAX_JOBS=1。
# false：海口经济学院也走大以论文云端规范，镜像不装 LibreOffice，适合小内存服务器。
# 修改后需要重新构建：docker compose up -d --build
THESIS_LOCAL_FORMAT=true
# 同时进行的本地排版任务数。2 核 2G 服务器请保持 1。
THESIS_MAX_JOBS=1

# EC2/Compose 生产部署（本地运行可留空）
DOMAIN=your-domain.example
THESIS_ENV=production
THESIS_ALLOWED_HOSTS=
# 默认公开访问；如需访问口令，填写用户名并配置密码文件。
THESIS_AUTH_USER=
THESIS_AUTH_PASS=
THESIS_AUTH_PASS_FILE=
THESIS_REQUIRE_AUTH=false
# 独立保护分销后台；设置用户名和密码文件后开放 /admin/affiliates。
AFFILIATE_ADMIN_USER=
# 环境变量名保持大写；目录和文件名全部小写（Linux 区分大小写）。
# 宿主机 deploy/secrets/affiliate_admin_pass 对应容器 /run/secrets/affiliate_admin_pass。
# 设置独立管理员密码时，下面填 /run/secrets/affiliate_admin_pass。
AFFILIATE_ADMIN_PASS_FILE=
# Docker secrets 中的可选文件路径；本地默认仍兼容 .secrets/。
DAYIPAPER_PAT_FILE=
# 可选 DeepSeek Harness（独立入口，不修改论文网站前端）。
# 使用时叠加 docker-compose.dsh.yml，详见 docs/deepseek-harness.md。
# 留空关闭；填 dsh 开启。关闭已经运行的服务还需执行文档中的 stop 命令。
COMPOSE_PROFILES=
DSH_VERSION=0.2.1-rc.5
DSH_PORT=3081
DSH_MEMORY_LIMIT=512m
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com


# ---------------- DeepSeek Harness (DSH) ----------------
# 智能文档预处理与质量检查。关闭时 DSH 完全不生效，不产生任何 API 调用。
# 留空则用 schools/hkjjxy/profile.yaml 里的 dsh.enabled（当前为 true）。
# 没有 API Key 时自动跳过，不会让排版失败。
DSH_ENABLED=True
# API Key 可用环境变量直接给，也可用文件挂载（推荐生产环境）
DEEPSEEK_API_KEY=
DEEPSEEK_API_KEY_FILE=
DEEPSEEK_BASE_URL=https://api.deepseek.com
# deepseek-chat | deepseek-reasoner
DEEPSEEK_MODEL=deepseek-flash
# 思考深度：off | low | medium | high（仅部分模型支持，见 DEEPSEEK_MODEL）
# 注意：medium 时单次 CP1 实测约 50s，建议首次上线用 off（约 30s 内）
DEEPSEEK_REASONING_EFFORT=low
